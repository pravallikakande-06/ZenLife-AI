# Copy this file to ".env" and fill in only what you need. Everything is optional.
# Never commit your real .env file.

# --- Optional AI (leave blank to use offline rule-based guidance) ---
# AI_PROVIDER: anthropic | openai | ollama  (auto-detected if a key below is set)
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override (defaults: anthropic=claude-sonnet-5-5, openai=gpt-4o-mini, ollama=llama3.1)
AI_MODEL=
# Optional: OpenAI-compatible endpoint (for Ollama default is http://localhost:11434/v1)
OPENAI_BASE_URL=

# --- Optional passcode to lock the app (single shared passcode, not per-user accounts) ---
APP_PASSCODE=

# --- Optional email reminders (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
